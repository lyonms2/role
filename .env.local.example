# ==============================================
# ROLÊ — Variáveis de Ambiente
# Copia este arquivo para .env.local e preenche
# ==============================================

# OpenWeatherMap — https://openweathermap.org/api
# Plano gratuito é suficiente (1000 chamadas/dia)
OPENWEATHER_KEY=sua_key_aqui

# Cloudinary — https://cloudinary.com
# Upload de fotos dos usuários (25 GB grátis, sem cartão)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dckm0y0az
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=role_upload
CLOUDINARY_API_KEY=sua_api_key_aqui
CLOUDINARY_API_SECRET=seu_api_secret_aqui

# Firebase — https://console.firebase.google.com/
# Cria um projeto, ativa Firestore + Auth (Google)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Realtime Database — para rastreamento de grupo em tempo real
# Ative em console.firebase.google.com → Realtime Database → Criar banco
# URL no formato: https://[project-id]-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# RentCars Afiliados — https://affiliates.rentcars.com/pt-br/
NEXT_PUBLIC_RENTCARS_AFFILIATE_ID=

# Booking.com Afiliados — https://www.booking.com/affiliate-program/v2/index.pt-br.html
# O "aid" é o seu ID de afiliado (ex: aid=360920)
NEXT_PUBLIC_BOOKING_AID=

# Google Places API (New) — https://console.cloud.google.com/
# Ative a "Places API (New)" e gere uma API key restrita ao domínio do Vercel
# Usado para: busca de destinos turísticos por localização e fotos dos lugares
GOOGLE_PLACES_API_KEY=

# ✅ Mapa: Leaflet + OpenStreetMap (sem API key)
# ✅ Busca de cidades: Nominatim (sem API key)
# ✅ Tempo de carro: OSRM (sem API key)
