rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'leonardomorenodasilva3@gmail.com';
    }

    match /places/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['averageRating', 'reviewCount', 'verifiedReviewCount']));
    }

    match /reviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /reports/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null;
    }

    match /suggestions/{id} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.suggestedBy == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (request.auth != null && resource.data.suggestedBy == request.auth.uid);
    }

    match /events/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['averageRating', 'reviewCount']));
    }

    match /eventReviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /eats/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['averageRating', 'reviewCount']));
    }

    match /eatReviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /stays/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['averageRating', 'reviewCount']));
    }

    match /stayReviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /roteiros/{id} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /advertiser_requests/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
