rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'leonardomorenodasilva3@gmail.com';
    }

    function validRatingUpdate(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys)
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating >= 0
        && request.resource.data.averageRating <= 5
        && request.resource.data.reviewCount is int
        && request.resource.data.reviewCount >= 0;
    }

    match /places/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         validRatingUpdate(['averageRating', 'reviewCount', 'verifiedReviewCount']));
    }

    match /reviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /reports/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null;
    }

    match /suggestions/{id} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.suggestedBy == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.suggestedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (request.auth != null && resource.data.suggestedBy == request.auth.uid);
    }

    match /events/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         validRatingUpdate(['averageRating', 'reviewCount']));
    }

    match /eventReviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /eats/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         validRatingUpdate(['averageRating', 'reviewCount', 'priceRange', 'communityPriceSum']));
    }

    match /eatReviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /stays/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null &&
         validRatingUpdate(['averageRating', 'reviewCount', 'priceRange', 'communityPriceSum']));
    }

    match /stayReviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /roteiros/{id} {
      allow read: if resource.data.public == true ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /advertiser_requests/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
